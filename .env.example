# OpenLitterPI Environment Variables
# ===================================
# Copy this file to .env and fill in your values
# Then source it before running: source .env

# Email notifications (Gmail with App Password)
export OPENLITTERPI_EMAIL_FROM=your-email@gmail.com
export OPENLITTERPI_EMAIL_PASSWORD=your-app-password
export OPENLITTERPI_EMAIL_TO=recipient@example.com
